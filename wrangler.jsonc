{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excelisus-astro",
  "compatibility_date": "2026-11-01",
  // Solo corre para /api/* (reenvía el formulario al hosting). El resto lo sirve
  // Cloudflare directo desde dist/ sin pasar por el Worker. Ver hosting/LEEME.md.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
