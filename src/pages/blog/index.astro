---
import Base from '@/layouts/Base.astro';
import TarjetaArticulo from '@/components/blog/TarjetaArticulo.astro';
import CubiertaArticulo from '@/components/blog/CubiertaArticulo.astro';
import { blog, categoriasBlog, CATEGORIAS_BLOG } from '@/data/blog';
import { rutas } from '@/data/site';
import { articulosPublicados, fechaIso, fechaLegible, minutosDeLectura } from '@/utils/blog';
import { listaBlog, migas } from '@/seo/esquemas';

/**
 * Portada del blog. Usa la paleta de /curso-sst-1/ (morado, naranja y
 * amarillo) y lista todo lo publicado: el artículo destacado más reciente
 * arriba y el resto en rejilla, con filtro por categoría.
 */
const articulos = await articulosPublicados();
const destacado = articulos.find((a) => a.data.destacado) ?? articulos[0];
const resto = articulos.filter((a) => a !== destacado);

const filtros = [
  { clave: 'todos', nombre: 'Todo', total: resto.length },
  ...CATEGORIAS_BLOG.map((id) => ({
    clave: id,
    nombre: categoriasBlog[id].nombre,
    total: resto.filter((a) => a.data.categoria === id).length,
  })).filter((f) => f.total > 0),
];

const catDestacado = destacado && categoriasBlog[destacado.data.categoria];
const minutosDestacado = destacado ? minutosDeLectura(destacado.body) : 0;
const totalMinutos = articulos.reduce((s, a) => s + minutosDeLectura(a.body), 0);

const esquemas = [
  listaBlog(
    articulos.map((a) => ({
      titulo: a.data.titulo,
      ruta: `${blog.ruta}${a.id}/`,
      publicado: fechaIso(a.data.publicado),
    })),
  ),
  migas([
    { nombre: 'Inicio', ruta: '/' },
    { nombre: blog.titulo, ruta: blog.ruta },
  ]),
];
---

<Base titulo="Blog: SST, datos, marketing y software" descripcion={blog.descripcion}>
  {esquemas.map((e) => <script type="application/ld+json" set:html={JSON.stringify(e)} />)}

  <div class="blog" data-paleta="sst">
    <!-- ---------- portada ---------- -->
    <section class="portada-blog zona-oscura">
      <div class="portada-blog__trama" aria-hidden="true"></div>
      <div class="portada-blog__halo" aria-hidden="true"></div>

      <div class="wrap portada-blog__cuerpo">
        <div class="portada-blog__texto">
          <nav class="migas anim-fade" aria-label="Ruta de navegación">
            <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Blog</span>
          </nav>

          <h1 class="display portada-blog__titulo">
            <span class="mask"><span class="anim-rise">Blog</span></span>
            <span class="mask">
              <span class="anim-rise" style="animation-delay:.1s">
                <span class="fill-word" data-word="técnico">técnico</span>
              </span>
            </span>
          </h1>

          <p class="portada-blog__entradilla anim-fade" style="animation-delay:.6s">
            Guías prácticas de seguridad y salud en el trabajo, Power BI, SQL, Python, marketing digital y
            desarrollo de software. Escritas por quienes lo hacen a diario, para que las apliques mañana.
          </p>

          <ul class="portada-blog__datos anim-fade" style="animation-delay:.8s">
            <li><span class="hud hud--mute">Artículos</span><b>{String(articulos.length).padStart(2, '0')}</b></li>
            <li><span class="hud hud--mute">Categorías</span><b>{String(filtros.length - 1).padStart(2, '0')}</b></li>
            <li><span class="hud hud--mute">Lectura total</span><b>{totalMinutos} min</b></li>
          </ul>
        </div>

        <!-- consola decorativa con el isotipo: el «monitor» del blog -->
        <div class="consola anim-fade" style="animation-delay:.4s" aria-hidden="true">
          <div class="consola__barra">
            <span></span><span></span><span></span>
            <b>excelsius ~ blog</b>
          </div>
          <div class="consola__cuerpo">
            <img class="consola__logo" src="/favicon.png" alt="" width="64" height="64" />
            <p><i>$</i> ls ./blog --por categoria</p>
            {CATEGORIAS_BLOG.map((id) => (
              <p class="consola__fila" style={`--tono:${categoriasBlog[id].tono}`}>
                <span>{id}/</span>
                <em>{articulos.filter((a) => a.data.categoria === id).length} archivos</em>
              </p>
            ))}
            <p><i>$</i> <span class="consola__cursor"></span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- destacado ---------- -->
    {destacado && catDestacado && (
      <section class="seccion destacado-blog" aria-labelledby="titulo-destacado">
        <div class="wrap">
          <span class="hud rv">Lo más leído</span>
          <article
            class="destacado rv"
            style={`--tono:${catDestacado.tono};--tono-claro:${catDestacado.tonoClaro}`}>
            <a href={`${blog.ruta}${destacado.id}/`} class="destacado__enlace">
              <CubiertaArticulo
                categoria={destacado.data.categoria}
                slug={destacado.id}
                minutos={minutosDestacado}
                variante="destacado"
              />
              <div class="destacado__cuerpo">
                <span class="destacado__cat">{catDestacado.nombre}</span>
                <h2 id="titulo-destacado" class="destacado__titulo">{destacado.data.titulo}</h2>
                <p class="destacado__texto">{destacado.data.resumen}</p>
                <footer class="destacado__pie">
                  <time datetime={fechaIso(destacado.data.publicado)}>{fechaLegible(destacado.data.publicado)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{minutosDestacado} min de lectura</span>
                </footer>
                <span class="cta cta--azul destacado__cta"><i></i>Leer artículo</span>
              </div>
            </a>
          </article>
        </div>
      </section>
    )}

    <!-- ---------- listado ---------- -->
    <section class="seccion listado" aria-labelledby="titulo-listado">
      <div class="wrap">
        <div class="listado__cabecera rv">
          <h2 id="titulo-listado" class="titulo-seccion">
            <span class="mask"><span>Todos los <em>artículos</em></span></span>
          </h2>
          <ul class="filtros" aria-label="Filtrar por categoría">
            {filtros.map((f, n) => (
              <li>
                <button
                  type="button"
                  class="filtro"
                  data-filtro-blog={f.clave}
                  data-activo={n === 0}
                  aria-pressed={n === 0}
                  style={f.clave !== 'todos' ? `--tono:${categoriasBlog[f.clave as keyof typeof categoriasBlog].tono}` : undefined}>
                  {f.nombre}
                  <b class="mono-num">{String(f.total).padStart(2, '0')}</b>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <ul class="rejilla">
          {resto.map((a, n) => (
            <li data-ficha-blog={a.data.categoria}>
              <TarjetaArticulo articulo={a} retraso={(n % 3) * 90} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------- cierre ---------- -->
    <section class="seccion cierre zona-oscura">
      <div class="wrap cierre__cuerpo rv">
        <img src="/favicon.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
        <div>
          <span class="hud">Del artículo al aula</span>
          <h2 class="titulo-seccion">
            <span class="mask"><span>¿Quieres dominarlo <em>en vivo</em>?</span></span>
          </h2>
          <p class="entradilla">
            Cada tema del blog tiene un curso detrás, con especialistas en ejercicio, casos reales y
            certificación por horas académicas.
          </p>
        </div>
        <div class="cierre__acciones">
          <a href={rutas.cursos} class="cta cta--azul"><i></i>Ver cursos</a>
          <a href="/software/" class="cta cta--celeste"><i></i>Desarrollo de software</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { iniciarBlog } from '@/scripts/blog';
  iniciarBlog();
</script>

<style>
  /* ---------- portada ---------- */
  .portada-blog {
    position: relative;
    overflow: hidden;
    padding: clamp(120px, 16vh, 170px) 0 clamp(64px, 9vh, 96px);
    background: var(--fondo);
  }
  .portada-blog__trama {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 75%);
    opacity: 0.6;
  }
  .portada-blog__halo {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vmax;
    height: 70vmax;
    background:
      radial-gradient(circle at 60% 40%, rgba(106, 13, 173, 0.55), transparent 55%),
      radial-gradient(circle at 30% 70%, rgba(255, 102, 0, 0.28), transparent 50%);
    filter: blur(20px);
  }
  .portada-blog__cuerpo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  @media (max-width: 900px) {
    .portada-blog__cuerpo { grid-template-columns: 1fr; }
  }

  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .migas a:hover { color: var(--celeste); }
  .migas [aria-current] { color: var(--celeste); }

  .portada-blog__titulo { margin-top: 18px; }
  .portada-blog__entradilla {
    max-width: 56ch;
    margin-top: 22px;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.7;
    color: var(--mute);
  }
  .portada-blog__datos {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 40px);
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .portada-blog__datos b {
    display: block;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: clamp(18px, 2vw, 24px);
    color: var(--celeste);
  }

  /* consola */
  .consola {
    border: 1px solid var(--line-fuerte);
    background: rgba(8, 4, 16, 0.78);
    backdrop-filter: blur(6px);
    box-shadow: 0 30px 80px -30px rgba(106, 13, 173, 0.7);
    font-family: var(--mono);
    font-size: 13px;
  }
  .consola__barra {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
  }
  .consola__barra span { width: 9px; height: 9px; border-radius: 50%; background: var(--line-fuerte); }
  .consola__barra span:nth-child(1) { background: #ff6600; }
  .consola__barra span:nth-child(2) { background: #ffcc00; }
  .consola__barra span:nth-child(3) { background: #8b3fd0; }
  .consola__barra b { margin-left: auto; font-weight: 500; font-size: 11px; color: var(--mute); }
  .consola__cuerpo { position: relative; display: grid; gap: 9px; padding: 22px 20px 24px; color: #e8e2f2; }
  .consola__logo { position: absolute; top: 18px; right: 18px; width: 56px; height: 56px; }
  .consola__cuerpo i { font-style: normal; color: #ffcc00; }
  .consola__fila { display: flex; gap: 14px; padding-left: 16px; }
  .consola__fila span { min-width: 11ch; color: var(--tono); }
  .consola__fila em { font-style: normal; color: #9d93ad; }
  .consola__cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    vertical-align: -2px;
    background: #ff6600;
    animation: parpadeo 1s steps(2) infinite;
  }
  @keyframes parpadeo { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .consola__cursor { animation: none; }
  }

  /* ---------- destacado ---------- */
  .destacado {
    margin-top: 20px;
    border: 1px solid var(--line);
    background: var(--superficie);
    transition: border-color 0.3s ease;
  }
  .destacado:hover { border-color: color-mix(in srgb, var(--tono) 55%, transparent); }
  .destacado__enlace {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  @media (max-width: 860px) {
    .destacado__enlace { grid-template-columns: 1fr; }
  }
  .destacado__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3.4vw, 48px);
  }
  .destacado__cat,
  .destacado__pie {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .destacado__cat { color: var(--tono); }
  :root[data-tema='claro'] .destacado__cat { color: var(--tono-claro); }
  .destacado__titulo { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.15; letter-spacing: -0.02em; }
  .destacado__texto { font-size: 15px; line-height: 1.75; color: var(--mute); }
  .destacado__pie { display: flex; gap: 8px; color: var(--mute); }
  .destacado__cta { align-self: flex-start; margin-top: 8px; }

  /* ---------- listado ---------- */
  .listado { background: var(--superficie); }
  .listado__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .filtros { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtro {
    --tono: var(--acento);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    background: var(--fondo);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--texto);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .filtro b { color: var(--mute); font-weight: 500; }
  .filtro:hover { border-color: var(--tono); }
  .filtro[data-activo='true'] {
    border-color: var(--azul);
    background: var(--azul);
    color: var(--sobre-azul);
  }
  .filtro[data-activo='true'] b { color: inherit; opacity: 0.75; }
  .filtro:focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  /* ---------- cierre ---------- */
  .cierre { background: var(--velo-azul), var(--fondo); }
  .cierre__cuerpo {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  .cierre__cuerpo img { width: 72px; height: 72px; }
  .cierre__acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 900px) {
    .cierre__cuerpo { grid-template-columns: 1fr; }
  }
</style>
