---
import Base from '@/layouts/Base.astro';
import Portada from '@/components/ui/Portada.astro';
import { privacidad as pv } from '@/data/privacidad';
import { contacto, site } from '@/data/site';

/**
 * Política de privacidad. Conserva la URL del WordPress y el texto legal que
 * ya estaba publicado; lo que cambia es la lectura: secciones con título,
 * índice lateral y los datos de contacto para ejercer los derechos.
 */

const url = `${site.url}/politicas-privacidad/`;

const esquema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Políticas de privacidad',
  url,
  inLanguage: 'es-PE',
  description:
    'Política de privacidad de EXCELSIUS: qué datos personales recopilamos, cómo los usamos y cómo ejercer los derechos reconocidos por la Ley N.° 29733.',
  dateModified: pv.actualizado,
  publisher: { '@type': 'Organization', name: site.nombre, url: site.url },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Políticas de privacidad', item: url },
    ],
  },
};

const fecha = new Date(pv.actualizado).toLocaleDateString('es-PE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  titulo="Políticas de privacidad"
  descripcion="Qué datos personales recopila EXCELSIUS, para qué los usa, quién es el titular del banco de datos y cómo ejercer los derechos reconocidos por la Ley N.° 29733.">
  <script type="application/ld+json" set:html={JSON.stringify(esquema)} />

  <Portada
    hud="Legal"
    titulo={pv.titulo}
    acento="de la información"
    entradilla={pv.entradilla}
    datos={[
      { etiqueta: 'Última actualización', valor: fecha },
      { etiqueta: 'Marco legal', valor: 'Ley N.° 29733, Perú' },
      { etiqueta: 'Titular del banco de datos', valor: 'EXCELSIUS y Digital House' },
    ]}
  />

  <section class="seccion">
    <div class="wrap legal">
      <!-- índice: el texto es largo y conviene poder saltar -->
      <nav class="indice rv" aria-label="Contenido de la política">
        <span class="hud">Contenido</span>
        <ol>
          {pv.secciones.map((s, n) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="mono-num">{String(n + 1).padStart(2, '0')}</span>
                {s.titulo}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="texto">
        {pv.secciones.map((s, n) => (
          <section id={s.id} class="bloque rv">
            <h2 class="bloque__titulo">
              <span class="mono-num bloque__indice">{String(n + 1).padStart(2, '0')}</span>
              {s.titulo}
            </h2>
            {s.parrafos.map((p) => <p class="bloque__parrafo">{p}</p>)}

            {'lista' in s && s.lista && (
              <div class="bloque__lista">
                <span class="hud hud--mute">{s.lista.titulo}</span>
                <ul>
                  {s.lista.items.map((i) => (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
                      {i}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ))}

        <div class="cierre rv">
          <h2 class="cierre__titulo">{pv.cierre.titulo}</h2>
          <p class="cierre__texto">{pv.cierre.texto}</p>
          <ul class="cierre__datos">
            <li>
              <span class="hud hud--mute">Correo</span>
              <a href={contacto.correoLink}>{contacto.correo}</a>
            </li>
            <li>
              <span class="hud hud--mute">Teléfono y WhatsApp</span>
              <a href={contacto.telefonoLink}>{contacto.telefono}</a>
            </li>
            <li>
              <span class="hud hud--mute">Dirección</span>
              <span>{contacto.direccion}, {contacto.ciudad}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal {
    display: grid;
    grid-template-columns: minmax(0, 260px) 1fr;
    gap: clamp(28px, 5vw, 76px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .legal { grid-template-columns: 1fr; }
  }

  /* el índice acompaña la lectura en escritorio */
  .indice {
    position: sticky;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(20px, 2.2vw, 28px);
    border: 1px solid var(--line);
    background: var(--superficie);
  }
  @media (max-width: 900px) {
    .indice { position: static; }
  }
  .indice ol { display: flex; flex-direction: column; gap: 2px; }
  .indice a {
    display: flex;
    gap: 10px;
    padding: 9px 0 9px 12px;
    border-left: 2px solid var(--line);
    font-size: 13.5px;
    line-height: 1.4;
    transition: border-color 0.25s ease, color 0.25s ease, padding-left 0.25s ease;
  }
  .indice a:hover { border-left-color: var(--acento); color: var(--acento); padding-left: 16px; }
  .indice .mono-num { flex: 0 0 auto; font-size: 11px; color: var(--acento); }

  .texto { display: flex; flex-direction: column; gap: clamp(28px, 3.4vw, 48px); }

  .bloque { scroll-margin-top: 90px; }
  .bloque__titulo {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .bloque__indice {
    flex: 0 0 auto;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--acento);
  }
  .bloque__parrafo {
    max-width: 78ch;
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--mute);
  }

  .bloque__lista {
    margin-top: 22px;
    padding: clamp(18px, 2vw, 26px);
    border: 1px solid var(--line);
    background: var(--superficie);
  }
  .bloque__lista ul { display: flex; flex-direction: column; gap: 11px; margin-top: 14px; }
  .bloque__lista li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    max-width: 74ch;
    font-size: 14px;
    line-height: 1.6;
  }
  .bloque__lista svg { width: 15px; height: 15px; margin-top: 2px; flex: 0 0 auto; fill: var(--acento); }

  .cierre {
    padding: clamp(26px, 3vw, 40px);
    border: 1px solid var(--line-fuerte);
    background: var(--velo-azul), var(--superficie);
  }
  .cierre__titulo {
    max-width: 30ch;
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 1.25;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .cierre__texto { max-width: 70ch; margin-top: 14px; font-size: 14.5px; line-height: 1.7; color: var(--mute); }
  .cierre__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .cierre__datos li { display: flex; flex-direction: column; gap: 7px; }
  .cierre__datos a { font-size: 15px; transition: color 0.2s ease; }
  .cierre__datos a:hover { color: var(--acento); }
</style>
