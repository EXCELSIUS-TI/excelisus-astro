---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/layout/Logo.astro';
import Formulario from '@/components/ui/Formulario.astro';
import Institucional from '@/components/comun/Institucional.astro';
import { software as sw } from '@/data/software';
import { logoStack } from '@/data/logos-stack';
import { contacto, site } from '@/data/site';

/**
 * Desarrollo de software. Reescritura de `/software/`, la página que sigue
 * publicada en el WordPress con esa misma URL, en la paleta `violeta`:
 * morado en la estructura y el naranja del logotipo en los acentos.
 */

const url = `${site.url}/software/`;

/** tecnologías únicas de los ocho productos, para la franja del stack */
const tecnologias = [...new Set(sw.productos.flatMap((p) => p.stack))].filter((t) => logoStack(t));

const esquemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Desarrollo de software a medida',
    serviceType:
      'Desarrollo de software, aplicaciones móviles, comercio electrónico, ERP, CRM y Business Intelligence',
    url,
    description: sw.respuesta,
    provider: {
      '@type': 'Organization',
      name: site.nombre,
      url: site.url,
      telephone: '+51 951 753 920',
      email: contacto.correo,
    },
    areaServed: { '@type': 'Country', name: 'Perú' },
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: url,
      servicePhone: '+51 951 753 920',
      availableLanguage: 'es-PE',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Productos y servicios de software',
      itemListElement: sw.productos.map((p) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: p.nombre, description: p.detalle },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: sw.preguntas.map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${site.url}/servicios/` },
      { '@type': 'ListItem', position: 3, name: 'Desarrollo de software', item: url },
    ],
  },
];
---

<Base
  titulo="Desarrollo de software a medida"
  descripcion="Software a medida, apps iOS y Android, ecommerce, ERP Odoo, CRM Vtiger, macros en Excel y aulas virtuales, por ingenieros certificados en Perú.">
  {esquemas.map((e) => <script type="application/ld+json" set:html={JSON.stringify(e)} />)}

  <div class="sw" data-paleta="violeta">
    <!-- ---------- portada ---------- -->
    <section class="portada zona-oscura">
      <div class="portada__fondo" aria-hidden="true"></div>
      <div class="portada__trama" aria-hidden="true"></div>

      <div class="wrap portada__cuerpo">
        <nav class="miga" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/servicios/">Servicios</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Desarrollo de software</span>
        </nav>

        <div class="portada__marca anim-fade" style="animation-delay:.2s">
          <Logo alto={26} />
          <span class="hud">{sw.hero.hud}</span>
        </div>

        <h1 class="display portada__titulo">
          <span class="mask"><span class="anim-rise">{sw.hero.titulo}</span></span>
          <span class="mask">
            <span class="anim-rise" style="animation-delay:.1s">
              <span class="fill-word" data-word={sw.hero.acento}>{sw.hero.acento}</span>
            </span>
          </span>
        </h1>

        <p class="portada__sub anim-fade" style="animation-delay:.8s">{sw.hero.subtitulo}</p>
        <p class="portada__bajada anim-fade" style="animation-delay:.9s">{sw.hero.bajada}</p>

        <div class="portada__acciones anim-fade" style="animation-delay:1s">
          <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="cta cta--azul">
            <i></i>{sw.hero.cta}
          </a>
          <a href="#productos" class="cta cta--linea">Ver lo que hacemos</a>
        </div>
      </div>
    </section>

    <!-- respuesta directa -->
    <section class="resumen">
      <div class="wrap resumen__cuerpo">
        <span class="hud">En corto</span>
        <p class="resumen__texto">{sw.respuesta}</p>
      </div>
    </section>

    <!-- franja de tecnologías: carrusel continuo -->
    <section class="tecnologias" aria-label="Tecnologías con las que trabajamos">
      <div class="wrap">
        <span class="hud hud--mute tecnologias__titulo">Trabajamos con</span>
      </div>

      <div class="carrusel">
        <div class="carrusel__cinta">
          {/* la lista va dos veces: cuando la primera copia termina de salir,
              la segunda está justo donde empezó la primera y el salto no se ve */}
          {[0, 1].map((copia) => (
            <ul class="carrusel__lista" aria-hidden={copia === 1 ? 'true' : undefined}>
              {tecnologias.map((t) => (
                <li>
                  <img src={logoStack(t)} alt="" width="40" height="40" loading="lazy" decoding="async" />
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>

    <!-- ---------- productos ---------- -->
    <section id="productos" class="seccion">
      <div class="wrap">
        <header class="cab rv">
          <span class="hud"><span class="indice">01</span> Productos y servicios</span>
          <h2 class="titulo-seccion">
            <span class="mask"><span>Ocho formas de <em>resolverlo con software</em></span></span>
          </h2>
          <p class="entradilla">
            Desde un sistema hecho a medida hasta la automatización de una hoja de cálculo que hoy
            consume media jornada. La elección depende del problema y del presupuesto de operación,
            no de la moda del trimestre.
          </p>
        </header>

        <ul class="productos">
          {sw.productos.map((p, n) => (
            <li class="tarjeta producto rv" data-retraso={(n % 2) * 80}>
              <div class="producto__top">
                <span class="producto__ico">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={p.icono}></path></svg>
                </span>
                <span class="mono-num producto__indice">{p.indice}</span>
              </div>

              <h3 class="producto__titulo">{p.nombre}</h3>
              <p class="producto__texto">{p.detalle}</p>

              <ul class="producto__stack">
                {p.stack.map((t) => (
                  <li>
                    {logoStack(t) && (
                      <img src={logoStack(t)} alt="" width="14" height="14" loading="lazy" decoding="async" />
                    )}
                    {t}
                  </li>
                ))}
              </ul>

              <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="producto__link">
                Conversar por WhatsApp
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h12.2l-5.6-5.6L12 4l8 8-8 8-1.4-1.4 5.6-5.6H4z"></path></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------- proceso ---------- -->
    <section id="proceso" class="seccion proceso">
      <div class="wrap">
        <header class="cab rv">
          <span class="hud"><span class="indice">02</span> Cómo trabajamos</span>
          <h2 class="titulo-seccion">
            <span class="mask"><span>De la visita técnica <em>a producción</em></span></span>
          </h2>
        </header>

        <ol class="pasos">
          {sw.proceso.map((p) => (
            <li class="paso rv">
              <span class="mono-num paso__num">{p.paso}</span>
              <h3 class="paso__titulo">{p.nombre}</h3>
              <p class="paso__texto">{p.detalle}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ---------- por qué elegirnos ---------- -->
    <section class="seccion">
      <div class="wrap porque">
        <div class="rv">
          <span class="hud"><span class="indice">03</span> Por qué elegirnos</span>
          <h2 class="titulo-seccion">
            <span class="mask"><span>Ingenieros certificados, <em>trabajo ordenado</em></span></span>
          </h2>
          <p class="entradilla">
            Contamos con un equipo profesional de ingenieros certificados para brindar las mejores
            soluciones tecnológicas con un presupuesto competitivo.
          </p>
        </div>

        <ul class="porque__lista">
          {sw.razones.map((r, n) => (
            <li class="porque__item rv" data-retraso={n * 80}>
              <span class="mono-num porque__num">{String(n + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="porque__titulo">{r.titulo}</h3>
                <p class="porque__texto">{r.detalle}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------- cifras ---------- -->
    <section class="franja">
      <div class="wrap">
        <ul class="franja__lista">
          {sw.cifras.map((c, n) => (
            <li class="franja__item rv" data-retraso={n * 80}>
              <b class="mono-num franja__valor">{c.valor}</b>
              <span class="hud hud--mute">{c.etiqueta}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------- preguntas ---------- -->
    <section id="preguntas" class="seccion faq">
      <div class="wrap faq__cuerpo">
        <div class="rv">
          <span class="hud"><span class="indice">04</span> Preguntas frecuentes</span>
          <h2 class="titulo-seccion">
            <span class="mask"><span>Lo que <em>suelen preguntar</em></span></span>
          </h2>
          <p class="entradilla">
            Si tu duda no está aquí, escríbenos: respondemos en horario de oficina.
          </p>
          <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="cta cta--borde faq__cta">
            Preguntar por WhatsApp
          </a>
        </div>

        <ul class="faq__lista rv">
          {sw.preguntas.map((p, n) => (
            <li class="faq__item" data-acordeon data-abierto={n === 0}>
              <button type="button" class="faq__boton" data-acordeon-boton aria-expanded={n === 0}>
                <span>{p.pregunta}</span>
                <span class="faq__signo" aria-hidden="true"></span>
              </button>
              <div class="faq__panel" data-acordeon-panel>
                <p>{p.respuesta}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------- contacto ---------- -->
    <section id="cotizacion" class="seccion contacto">
      <div class="wrap contacto__cuerpo">
        <div class="rv">
          <span class="hud">Siguiente paso</span>
          <h2 class="titulo-seccion">
            <span class="mask"><span>{sw.cierre.titulo}</span></span>
          </h2>
          <p class="entradilla">{sw.cierre.texto}</p>
          <ul class="contacto__datos">
            <li><span class="hud hud--mute">WhatsApp</span><a href={contacto.telefonoLink}>{contacto.telefono}</a></li>
            <li><span class="hud hud--mute">Correo</span><a href={contacto.correoLink}>{contacto.correo}</a></li>
          </ul>
        </div>

        <div class="contacto__form rv">
          <Formulario asunto="Desarrollo de software" />
        </div>
      </div>
    </section>

    <Institucional indice="05" />
  </div>
</Base>

<style>
  .indice { padding-right: 12px; margin-right: 4px; border-right: 1px solid var(--line); color: var(--mute); }
  .cab { max-width: 74ch; }
  .cab .hud { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 18px; }

  /* ---------- portada ---------- */
  .portada {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(440px, 70vh, 680px);
    padding-block: clamp(92px, 11vw, 140px) clamp(40px, 5vw, 70px);
    overflow: hidden;
  }
  .portada__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(56% 58% at 76% 22%, rgba(122, 31, 162, 0.62), transparent 70%),
      radial-gradient(44% 50% at 10% 88%, rgba(255, 141, 0, 0.2), transparent 70%),
      radial-gradient(34% 40% at 48% 4%, rgba(157, 78, 221, 0.22), transparent 70%),
      #0a0612;
  }
  .portada__trama {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.3;
    background: repeating-linear-gradient(0deg, var(--trama) 0 1px, transparent 1px 3px);
  }
  .portada__cuerpo { position: relative; z-index: 2; }

  .miga {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .miga a:hover { color: var(--acento); }
  .miga [aria-current] { color: var(--texto); }

  .portada__marca { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; color: var(--texto); }
  .portada__titulo { font-size: clamp(40px, 6.6vw, 94px); line-height: 0.92; max-width: 14ch; }
  .portada__sub { max-width: 56ch; margin-top: 24px; font-size: clamp(15px, 1.5vw, 20px); line-height: 1.5; }
  .portada__bajada { max-width: 64ch; margin-top: 14px; font-size: 14.5px; line-height: 1.65; color: var(--mute); }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  /* ---------- resumen ---------- */
  .resumen {
    position: relative;
    z-index: 2;
    border-top: 2px solid var(--celeste);
    background: var(--superficie);
    padding-block: clamp(26px, 3vw, 40px);
  }
  .resumen__cuerpo {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(14px, 2vw, 32px);
    align-items: start;
  }
  @media (max-width: 700px) {
    .resumen__cuerpo { grid-template-columns: 1fr; gap: 10px; }
  }
  .resumen__texto { max-width: 92ch; font-size: clamp(15px, 1.35vw, 18px); line-height: 1.65; }

  /* ---------- franja de tecnologías ---------- */
  .tecnologias {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: var(--fondo);
    padding-block: clamp(26px, 3vw, 40px);
  }
  .tecnologias__titulo { display: block; margin-bottom: 20px; }

  /* el carrusel se sale del canal para tocar ambos bordes de la pantalla */
  .carrusel {
    position: relative;
    overflow: hidden;
    /* difumina la entrada y la salida, para que no se corten en seco */
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .carrusel__cinta {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    animation: desfile 46s linear infinite;
  }
  /* al pasar el ratón o al llegar con el tabulador, la cinta se detiene */
  .carrusel:hover .carrusel__cinta,
  .carrusel:focus-within .carrusel__cinta { animation-play-state: paused; }

  @keyframes desfile {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  .carrusel__lista { display: flex; flex-wrap: nowrap; align-items: center; }
  .carrusel__lista li {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-inline: clamp(20px, 2.6vw, 40px);
    font-family: var(--mono);
    font-size: clamp(13px, 1.15vw, 16px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--mute);
    transition: color 0.25s ease;
  }
  .carrusel__lista li:hover { color: var(--texto); }
  .carrusel__lista img {
    width: clamp(32px, 3.2vw, 44px);
    height: clamp(32px, 3.2vw, 44px);
    flex: 0 0 auto;
  }
  :root[data-tema='oscuro'] .carrusel__lista img[src*='flutter'],
  :root[data-tema='oscuro'] .carrusel__lista img[src*='wordpress'],
  :root[data-tema='oscuro'] .carrusel__lista img[src*='odoo'],
  :root[data-tema='oscuro'] .carrusel__lista img[src*='nextdotjs'] {
    filter: brightness(1.9) saturate(1.15);
  }

  /* Quien pide menos movimiento no recibe el desplazamiento automático, pero
     la franja sigue siendo una fila que se arrastra a mano: envolverla la
     convertía en una columna en pantallas estrechas. El `!important` es para
     ganarle a la regla global que acorta todas las animaciones. */
  @media (prefers-reduced-motion: reduce) {
    .carrusel {
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: none;
    }
    .carrusel::-webkit-scrollbar { display: none; }
    .carrusel__cinta {
      animation: none !important;
      transform: none !important;
    }
    .carrusel__lista[aria-hidden='true'] { display: none; }
  }

  /* ---------- productos ---------- */
  .productos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: clamp(36px, 4.4vw, 60px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 820px) {
    .productos { grid-template-columns: 1fr; }
  }

  .producto { gap: 13px; }
  .producto__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .producto__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--celeste) 14%, transparent);
    color: var(--celeste);
  }
  .producto__ico svg { width: 22px; height: 22px; fill: currentColor; }
  .producto__indice { font-size: 12px; letter-spacing: 0.2em; color: var(--mute); }

  .producto__titulo { font-size: clamp(18px, 1.7vw, 23px); line-height: 1.25; text-transform: uppercase; letter-spacing: -0.02em; }
  .producto__texto { font-size: 13.8px; line-height: 1.7; color: var(--mute); }

  .producto__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 18px;
  }
  .producto__stack li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px 5px 7px;
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .producto__stack li:hover { border-color: var(--line-fuerte); color: var(--texto); }
  .producto__stack li:not(:has(img)) { padding-left: 10px; }
  .producto__stack img { width: 14px; height: 14px; flex: 0 0 auto; }
  :root[data-tema='oscuro'] .producto__stack img[src*='flutter'],
  :root[data-tema='oscuro'] .producto__stack img[src*='wordpress'],
  :root[data-tema='oscuro'] .producto__stack img[src*='odoo'],
  :root[data-tema='oscuro'] .producto__stack img[src*='nextdotjs'] {
    filter: brightness(1.9) saturate(1.15);
  }

  .producto__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--acento);
    transition: gap 0.25s ease;
  }
  .producto__link:hover { gap: 15px; }
  .producto__link svg { width: 14px; height: 14px; fill: currentColor; }

  /* ---------- proceso ---------- */
  .proceso { background: var(--velo-alt), var(--superficie); }
  .pasos {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    margin-top: clamp(34px, 4vw, 56px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 1000px) {
    .pasos { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .pasos { grid-template-columns: 1fr; }
  }
  .paso {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2.2vw, 28px);
    background: var(--fondo);
  }
  .paso__num { font-size: clamp(20px, 2.4vw, 30px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--celeste); }
  .paso__titulo { font-size: 15px; text-transform: uppercase; letter-spacing: -0.01em; }
  .paso__texto { font-size: 13px; line-height: 1.65; color: var(--mute); }

  /* ---------- por qué ---------- */
  .porque {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 4vw, 70px);
    align-items: start;
  }
  @media (max-width: 960px) {
    .porque { grid-template-columns: 1fr; }
  }
  .porque__lista { display: flex; flex-direction: column; }
  .porque__item {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 16px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }
  .porque__item:last-child { border-bottom: 1px solid var(--line); }
  .porque__num { font-size: 12px; letter-spacing: 0.2em; color: var(--celeste); }
  .porque__titulo { font-size: clamp(17px, 1.6vw, 21px); text-transform: uppercase; letter-spacing: -0.01em; }
  .porque__texto { margin-top: 8px; font-size: 14px; line-height: 1.7; color: var(--mute); }

  /* ---------- cifras ---------- */
  .franja {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: var(--superficie);
    padding-block: clamp(32px, 4vw, 52px);
  }
