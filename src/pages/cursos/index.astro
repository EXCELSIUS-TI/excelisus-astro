---
import Base from '@/layouts/Base.astro';
import Portada from '@/components/ui/Portada.astro';
import TarjetaCurso from '@/components/cursos/TarjetaCurso.astro';
import { cursos, categorias, cursosPorCategoria } from '@/data/cursos';
import { contacto } from '@/data/site';

const filtros = [
  { clave: 'todos', nombre: 'Todos los cursos', total: cursos.length },
  ...categorias.map((c) => ({
    clave: c.id,
    nombre: c.nombre,
    total: cursosPorCategoria(c.id).length,
  })),
];
---

<Base
  titulo="Cursos"
  descripcion="Cursos de especialización en vivo con IA aplicada: Supervisor SSOMA, Plan de Marketing con IA, SQL Server, Python y Power BI. Certificación por horas académicas.">
  <div class="cursos-pagina" data-paleta="indigo">
  <Portada
    hud="Matrículas abiertas 2026"
    titulo="Especialización"
    acento="con IA aplicada"
    entradilla="Programas en vivo, dictados por especialistas en ejercicio, con enfoque práctico y certificación por horas académicas. Elige tu línea y avanza con las herramientas que el mercado ya está exigiendo."
    datos={[
      { etiqueta: 'Cursos activos', valor: String(cursos.length).padStart(2, '0') },
      { etiqueta: 'Modalidad', valor: 'En vivo, con grabaciones' },
      { etiqueta: 'Horario', valor: contacto.horarioClases.replace('Clases en vivo de ', '') },
    ]}
  />

  <section class="seccion">
    <div class="wrap">
      <div class="barra">
        <ul class="filtros">
          {filtros.map((f, n) => (
            <li>
              <button
                type="button"
                class="filtro"
                data-filtro={f.clave}
                data-activo={n === 0}
                aria-pressed={n === 0}>
                {f.nombre}
                <b class="mono-num">{String(f.total).padStart(2, '0')}</b>
              </button>
            </li>
          ))}
        </ul>
        <span class="hud hud--mute barra__conteo">
          Mostrando <b class="mono-num" data-conteo>{String(cursos.length).padStart(2, '0')}</b>
        </span>
      </div>

      <ul class="grid">
        {cursos.map((c, n) => (
          <li><TarjetaCurso curso={c} retraso={(n % 3) * 90} /></li>
        ))}
      </ul>

      <a href="/curso-sst-1/" class="banda rv">
        <div>
          <span class="hud">Capacitaciones in house</span>
          <h3 class="banda__titulo">Cursos SST para empresas · Ley 29783</h3>
          <p class="banda__texto">
            Primeros auxilios, trabajos en altura e IPERC, virtual o presencial, con certificados y
            registros listos para auditoría.
          </p>
        </div>
        <span class="banda__flecha" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 11h12.2l-5.6-5.6L12 4l8 8-8 8-1.4-1.4 5.6-5.6H4z"></path></svg>
        </span>
      </a>
    </div>
  </section>

  <section class="seccion lineas">
    <div class="wrap">
      <span class="hud">Líneas de especialización</span>
      <h2 class="titulo-seccion lineas__titulo">
        <span class="mask"><span>Tres caminos, <em>un mismo método</em></span></span>
      </h2>

      <ul class="lineas__lista">
        {categorias.map((c) => (
          <li id={c.id} class="linea rv">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={c.icono}></path></svg>
            <h3 class="linea__titulo">{c.nombre}</h3>
            <p class="linea__texto">{c.descripcion}</p>
            <ul class="linea__cursos">
              {cursosPorCategoria(c.id).map((k) => (
                <li>
                  <a href={`/cursos/${k.slug}/`}>
                    <strong>{k.titulo}</strong>
                    <span>{k.proximo ? 'Próximo inicio' : `${k.horas} · ${k.sesiones}`}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>

      <div class="cierre rv">
        <div>
          <h3 class="cierre__titulo">¿No sabes cuál es el curso indicado para ti?</h3>
          <p class="cierre__texto">
            Conversemos. Te orientamos sobre la línea de especialización, el temario y las
            modalidades de pago según tu perfil profesional y tus objetivos.
          </p>
        </div>
        <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="cta cta--celeste">
          <i></i>Asesoría gratuita
        </a>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  /* Índigo del logotipo como color estructural y su naranja en los acentos:
     el filtro activo, el borde de la banda y los números del listado. */
  .filtro b,
  .barra__conteo b,
  .linea svg,
  .banda__flecha svg { color: #ff8d00; fill: #ff8d00; }
  :root[data-tema='claro'] .filtro b,
  :root[data-tema='claro'] .barra__conteo b,
  :root[data-tema='claro'] .linea svg,
  :root[data-tema='claro'] .banda__flecha svg { color: #b35309; fill: #b35309; }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }

  .filtros { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtro {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
    transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease;
  }
  .filtro b { font-weight: 400; color: var(--acento); }
  .filtro:hover { border-color: var(--line-fuerte); color: var(--texto); }
  .filtro[data-activo='true'] {
    background: var(--azul);
    border-color: var(--azul);
    color: #fff;
  }
  .filtro[data-activo='true'] b { color: rgba(255, 255, 255, 0.75); }

  .barra__conteo b { color: var(--acento); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 32px;
  }
  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
  .grid > li[hidden] { display: none; }

  .banda {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding: clamp(24px, 3vw, 38px);
    border: 1px solid var(--line-fuerte);
    background: var(--velo-azul), var(--superficie);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .banda:hover { transform: translateY(-3px); }
  .banda__titulo {
    margin-top: 12px;
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .banda__texto { max-width: 62ch; margin-top: 10px; font-size: 14px; line-height: 1.65; color: var(--mute); }
  .banda__flecha { flex: 0 0 auto; display: flex; }
  .banda__flecha svg { width: 30px; height: 30px; fill: var(--acento); }

  .lineas { background: var(--superficie); }
  .lineas__titulo { margin-top: 18px; }
  .lineas__lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: clamp(34px, 4vw, 56px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .lineas__lista { grid-template-columns: 1fr; }
  }

  .linea {
    padding: clamp(24px, 2.6vw, 34px);
    background: var(--fondo);
    scroll-margin-top: 90px;
  }
  .linea svg { width: 22px; height: 22px; fill: var(--acento); }
  .linea__titulo { margin-top: 14px; font-size: 18px; line-height: 1.3; }
  .linea__texto { margin-top: 8px; font-size: 13.5px; line-height: 1.6; color: var(--mute); }

  .linea__cursos { margin-top: 20px; display: flex; flex-direction: column; }
  .linea__cursos a {
    display: block;
    padding: 12px 0 12px 14px;
    border-left: 2px solid var(--line);
    transition: border-color 0.25s ease, padding-left 0.3s ease;
  }
  .linea__cursos a:hover { border-color: var(--acento); padding-left: 20px; }
  .linea__cursos strong { display: block; font-size: 13.5px; line-height: 1.35; }
  .linea__cursos span {
    display: block;
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .cierre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: clamp(34px, 4vw, 56px);
    padding: clamp(28px, 3.6vw, 48px);
    border: 1px solid var(--line-fuerte);
    background: var(--velo-azul), var(--fondo);
  }
  .cierre__titulo {
    max-width: 24ch;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .cierre__texto { max-width: 58ch; margin-top: 12px; font-size: 14px; line-height: 1.65; color: var(--mute); }
</style>
