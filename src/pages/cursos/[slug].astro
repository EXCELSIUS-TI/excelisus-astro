---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/layout/Logo.astro';
import Formulario from '@/components/ui/Formulario.astro';
import TarjetaCurso from '@/components/cursos/TarjetaCurso.astro';
import Cubierta from '@/components/cursos/Cubierta.astro';
import Terminal from '@/components/cursos/Terminal.astro';
import LogoTec from '@/components/cursos/LogoTec.astro';
import Certificado from '@/components/comun/Certificado.astro';
import MediosPago from '@/components/comun/MediosPago.astro';
import Institucional from '@/components/comun/Institucional.astro';
import { cursos, categoriaPorId, faqCurso, respuestaCurso } from '@/data/cursos';
import type { Curso } from '@/data/cursos';
import { contacto, site } from '@/data/site';
import { descripcionDeCurso } from '@/seo/seo';

/**
 * Página de curso. Sigue el orden del brochure institucional:
 *   1 portada (marca, título e imagen)   4 modelo de certificado
 *   2 presentación, beneficios, público  5 medios de pago
 *   3 plan de estudios                   6 información institucional y marcas
 *
 * Sobre esa estructura se monta el trabajo de posicionamiento: respuesta
 * directa para asistentes (AEO/GEO), preguntas frecuentes y los esquemas
 * Course, FAQPage y BreadcrumbList.
 */

export function getStaticPaths() {
  return cursos.map((curso) => ({ params: { slug: curso.slug }, props: { curso } }));
}

type Props = { curso: Curso };
const { curso } = Astro.props;

const cat = categoriaPorId(curso.categoria);
const preguntas = faqCurso(curso);
const respuesta = respuestaCurso(curso);
const url = `${site.url}/cursos/${curso.slug}/`;

/** imágenes del curso repartidas por la sección tras la que van */
const imagenesDe = (zona: 'presentacion' | 'objetivos' | 'plan') =>
  (curso.imagenes ?? []).filter((i) => i.zona === zona);

const relacionados = cursos.filter((c) => c.slug !== curso.slug && c.categoria === curso.categoria);
const otros = (relacionados.length ? relacionados : cursos.filter((c) => c.slug !== curso.slug)).slice(0, 3);

/** horas académicas → duración ISO 8601, que es lo que entiende schema.org.
    Si la duración del curso se mide en clases y no en horas, se omite: es
    preferible no declarar el dato a declararlo mal. */
const horasNumero = Number(curso.horas.match(/\d+/)?.[0] ?? 0);
const duracion = /hora/i.test(curso.horas) && horasNumero ? `PT${horasNumero}H` : undefined;

const esquemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: curso.titulo,
    alternateName: curso.subtitulo,
    description: respuesta,
    url,
    inLanguage: 'es-PE',
    isAccessibleForFree: false,
    teaches: curso.objetivos,
    audience: { '@type': 'EducationalAudience', educationalRole: 'professional', audienceType: curso.publico },
    provider: {
      '@type': 'Organization',
      name: site.nombre,
      url: site.url,
      telephone: '+51 951 753 920',
      email: contacto.correo,
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: duracion,
      location: { '@type': 'VirtualLocation', url },
      instructor: { '@type': 'Organization', name: site.nombre },
    },
    ...(curso.imagenes?.length
      ? {
          /* cada imagen se declara con su descripción: es lo que Google
             muestra en resultados de imagen y lo que cita un asistente */
          image: curso.imagenes.map((i) => ({
            '@type': 'ImageObject',
            contentUrl: `${site.url}${i.src}`,
            url: `${site.url}${i.src}`,
            caption: i.pie,
            description: i.alt,
            name: i.titulo,
            width: i.ancho,
            height: i.alto,
          })),
        }
      : {}),
    syllabusSections: curso.temario.map((m, n) => ({
      '@type': 'Syllabus',
      name: m.titulo,
      position: n + 1,
      description: (m.temas?.map((t) => t.titulo) ?? m.items ?? []).join(' · '),
    })),
    ...(curso.precio
      ? {
          offers: {
            '@type': 'Offer',
            price: curso.precio.contado.replace(/[^\d.]/g, ''),
            priceCurrency: 'PEN',
            category: 'Paid',
            availability: 'https://schema.org/InStock',
            url,
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: preguntas.map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Cursos', item: `${site.url}/cursos/` },
      { '@type': 'ListItem', position: 3, name: curso.titulo, item: url },
    ],
  },
];

/* El buscador corta el título a ~60 caracteres y la descripción a ~160, y la
   plantilla añade « · EXCELSIUS»: de ahí el título corto opcional y una
   descripción construida con los datos, no con el resumen entero. */
const titulo = curso.tituloSeo ?? curso.titulo;
const base = descripcionDeCurso(curso);
/* la coletilla solo entra si la descripción sigue cabiendo en el resultado */
const cola = ' Certificación por horas académicas.';
const descripcion = base.length + cola.length <= 160 ? base + cola : base;
---

<Base titulo={titulo} descripcion={descripcion}>
  {esquemas.map((e) => <script type="application/ld+json" set:html={JSON.stringify(e)} />)}

  <div class="curso-pagina" data-paleta={curso.paleta ?? 'azul'}>

  <!-- ======== 1 · PORTADA: marca, título e imagen ======== -->
  <section class="portada zona-oscura">
    <div class="portada__fondo" aria-hidden="true"></div>
    <div class="portada__trama" aria-hidden="true"></div>

    <div class="wrap portada__cuerpo">
      <nav class="miga" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/cursos/">Cursos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{curso.titulo}</span>
      </nav>

      <div class="portada__grid">
        <div>
          <div class="portada__marca anim-fade" style="animation-delay:.2s">
            <Logo alto={26} />
            <span class="hud">{cat.nombre}</span>
            {curso.logo && <LogoTec logo={curso.logo} alto={30} class="portada__tech" />}
          </div>

          <h1 class="display portada__titulo">
            <span class="mask"><span class="anim-rise">{curso.titulo}</span></span>
          </h1>
          <p class="portada__sub anim-fade" style="animation-delay:.7s">{curso.subtitulo}</p>

          <ul class="portada__datos anim-fade" style="animation-delay:.85s">
            <li><span class="hud hud--mute">Duración</span><b>{curso.horas}</b></li>
            <li><span class="hud hud--mute">Sesiones</span><b>{curso.sesiones}</b></li>
            <li><span class="hud hud--mute">Días</span><b>{curso.dias}</b></li>
            <li><span class="hud hud--mute">Horario</span><b>{curso.horario}</b></li>
            {curso.precio && (
              <li><span class="hud hud--mute">Inversión</span><b>{curso.precio.contado}</b></li>
            )}
            {curso.precio && (
              <li><span class="hud hud--mute">Financiado</span><b>{curso.precio.cuotas}</b></li>
            )}
          </ul>

          <div class="portada__acciones anim-fade" style="animation-delay:1s">
            <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="cta cta--azul">
              <i></i>{curso.proximo ? 'Avisarme del inicio' : 'Quiero inscribirme'}
            </a>
            <a href="#plan" class="cta cta--linea">Ver plan de estudios</a>
          </div>
        </div>

        <Cubierta curso={curso} variante="portada" class="portada__cubierta anim-fade" />
      </div>
    </div>
  </section>

  <!-- respuesta directa: lo que cita un asistente cuando le preguntan por el curso -->
  <section class="resumen">
    <div class="wrap resumen__cuerpo">
      <span class="hud">En corto</span>
      <p class="resumen__texto">{respuesta}</p>
    </div>
  </section>

  <!-- ======== 2 · PRESENTACIÓN, BENEFICIOS Y PÚBLICO ======== -->
  <section id="presentacion" class="seccion">
    <div class="wrap">
      <div class="presenta">
        <div class="rv">
          <span class="hud"><span class="indice">01</span> Presentación del curso</span>
          <h2 class="titulo-seccion presenta__titulo">
            <span class="mask"><span>De qué trata <em>este curso</em></span></span>
          </h2>
          <p class="presenta__texto">{curso.presentacion}</p>
        </div>

        <Cubierta curso={curso} variante="ejecucion" class="rv" />
      </div>

      {imagenesDe('presentacion').map((img) => (
        <figure class="ilustra rv">
          <div class="ilustra__texto">
            <span class="hud">En la práctica</span>
            <h3 class="ilustra__titulo">{img.titulo}</h3>
            <p class="ilustra__parrafo">{img.texto}</p>
            {img.puntos && (
              <ul class="ilustra__puntos">
                {img.puntos.map((punto) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
                    {punto}
                  </li>
                ))}
              </ul>
            )}
            <figcaption class="ilustra__pie">{img.pie}</figcaption>
          </div>
          <img
            src={img.src}
            alt={img.alt}
            width={img.ancho}
            height={img.alto}
            loading="lazy"
            decoding="async"
            class={img.ancho >= img.alto ? 'ilustra__img' : 'ilustra__img ilustra__img--alta'}
          />
        </figure>
      ))}

      <div class="doble">
        <div class="bloque rv">
          <span class="hud">Objetivos del curso</span>
          <ul class="lista-check">
            {curso.objetivos.map((o) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
                {o}
              </li>
            ))}
          </ul>
        </div>

        <div class="bloque rv">
          <span class="hud">Beneficios</span>
          <ul class="lista-check">
            {curso.beneficios.map((b) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h12.2l-5.6-5.6L12 4l8 8-8 8-1.4-1.4 5.6-5.6H4z"></path></svg>
                {b}
              </li>
            ))}
          </ul>
        </div>
      </div>

      {imagenesDe('objetivos').map((img) => (
        <figure class="ilustra rv">
          <div class="ilustra__texto">
            <span class="hud">Programa</span>
            <h3 class="ilustra__titulo">{img.titulo}</h3>
            <p class="ilustra__parrafo">{img.texto}</p>
            {img.puntos && (
              <ul class="ilustra__puntos">
                {img.puntos.map((punto) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
                    {punto}
                  </li>
                ))}
              </ul>
            )}
            <figcaption class="ilustra__pie">{img.pie}</figcaption>
          </div>
          <img
            src={img.src}
            alt={img.alt}
            width={img.ancho}
            height={img.alto}
            loading="lazy"
            decoding="async"
            class={img.ancho >= img.alto ? 'ilustra__img' : 'ilustra__img ilustra__img--alta'}
          />
        </figure>
      ))}

      <div class="bloque publico rv">
        <span class="hud">Público objetivo</span>
        <p>{curso.publico}</p>
      </div>
    </div>
  </section>

  {curso.terminal && <Terminal terminal={curso.terminal} />}

  <!-- ======== 3 · PLAN DE ESTUDIOS ======== -->
  <section id="plan" class="seccion plan">
    <div class="wrap">
      <header class="rv">
        <span class="hud"><span class="indice">02</span> Plan de estudios</span>
        <h2 class="titulo-seccion plan__titulo">
          <span class="mask"><span>{curso.temario.length} módulos, <em>clase por clase</em></span></span>
        </h2>
      </header>

      <ul class="plan__datos rv">
        <li><span class="hud hud--mute">Sesiones</span><b>{curso.sesiones}</b></li>
        <li><span class="hud hud--mute">Días</span><b>{curso.dias}</b></li>
        <li><span class="hud hud--mute">Horario</span><b>{curso.horario}</b></li>
        <li><span class="hud hud--mute">Certificación</span><b>{curso.horas}</b></li>
      </ul>

      <ul class="temario rv">
        {curso.temario.map((m, n) => (
          <li class="modulo" data-acordeon data-abierto={n === 0}>
            <button type="button" class="modulo__boton" data-acordeon-boton aria-expanded={n === 0}>
              <span class="mono-num modulo__num">{String(n + 1).padStart(2, '0')}</span>
              <span class="modulo__titulo">{m.titulo}</span>
              <span class="modulo__signo" aria-hidden="true"></span>
            </button>

            <div class="modulo__panel" data-acordeon-panel>
              {m.temas ? (
                <ul class="temas">
                  {m.temas.map((t) => (
                    <li class="tema">
                      <h3 class="tema__titulo">{t.titulo}</h3>
                      {t.puntos && (
                        <ul class="tema__puntos">
                          {t.puntos.map((p) => <li>{p}</li>)}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="tema__puntos tema__puntos--sueltos">
                  {(m.items ?? []).map((i) => <li>{i}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>

      {imagenesDe('plan').map((img) => (
        <figure class="ilustra rv">
          <div class="ilustra__texto">
            <span class="hud">Metodología</span>
            <h3 class="ilustra__titulo">{img.titulo}</h3>
            <p class="ilustra__parrafo">{img.texto}</p>
            {img.puntos && (
              <ul class="ilustra__puntos">
                {img.puntos.map((punto) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
                    {punto}
                  </li>
                ))}
              </ul>
            )}
            <figcaption class="ilustra__pie">{img.pie}</figcaption>
          </div>
          <img
            src={img.src}
            alt={img.alt}
            width={img.ancho}
            height={img.alto}
            loading="lazy"
            decoding="async"
            class={img.ancho >= img.alto ? 'ilustra__img' : 'ilustra__img ilustra__img--alta'}
          />
        </figure>
      ))}
    </div>
  </section>

  <!-- ======== 4 · MODELO DE CERTIFICADO ======== -->
  <section id="certificado" class="seccion">
    <div class="wrap certificado">
      <div class="rv">
        <span class="hud"><span class="indice">03</span> Certificación</span>
        <h2 class="titulo-seccion">
          <span class="mask"><span>Modelo <em>de certificado</em></span></span>
        </h2>
        <p class="entradilla">
          Al aprobar el programa recibes un certificado a nombre de Excelsius por {curso.horas}, con
          el detalle de la duración y la fecha de emisión. Es el documento que sustenta tu
          formación ante tu empleador o en un proceso de selección.
        </p>
        <ul class="lista-check certificado__lista">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
            Emisión digital, lista para adjuntar a tu CV o a tu legajo.
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
            Detalle de horas académicas y del temario cursado.
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"></path></svg>
            Para empresas, informe de participación y asistencia del grupo.
          </li>
        </ul>
      </div>

      <div class="rv">
        <Certificado curso={curso.titulo} horas={curso.horas} respaldo={cat.nombre} />
      </div>
    </div>
  </section>

  <!-- ======== 5 · MEDIOS DE PAGO ======== -->
  <MediosPago indice="04" titulo="Medios" acento="de pago" />

  <!-- preguntas frecuentes: para quien lee y para quien pregunta a un asistente -->
  <section id="preguntas" class="seccion faq">
    <div class="wrap faq__cuerpo">
      <div class="rv">
        <span class="hud"><span class="indice">05</span> Preguntas frecuentes</span>
        <h2 class="titulo-seccion">
          <span class="mask"><span>Lo que <em>suelen preguntar</em></span></span>
        </h2>
        <p class="entradilla">
          Si tu duda no está aquí, escríbenos por WhatsApp: respondemos en horario de oficina.
        </p>
        <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="cta cta--borde faq__cta">
          Preguntar por WhatsApp
        </a>
      </div>

      <ul class="faq__lista rv">
        {preguntas.map((p, n) => (
          <li class="faq__item" data-acordeon data-abierto={n === 0}>
            <button type="button" class="faq__boton" data-acordeon-boton aria-expanded={n === 0}>
              <span>{p.pregunta}</span>
              <span class="faq__signo" aria-hidden="true"></span>
            </button>
            <div class="faq__panel" data-acordeon-panel>
              <p>{p.respuesta}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- matrícula -->
  <section id="matricula" class="seccion matricula">
    <div class="wrap matricula__cuerpo">
      <div class="rv">
        <span class="hud">Matrícula</span>
        <h2 class="titulo-seccion">
          <span class="mask"><span>Reserva <em>tu vacante</em></span></span>
        </h2>
        <p class="entradilla">
          Cupos limitados. Clases en vivo con acceso a las grabaciones. Déjanos tus datos y te
          enviamos el temario completo, las fechas de inicio y las formas de pago.
        </p>
        <ul class="matricula__datos">
          <li><span class="hud hud--mute">WhatsApp</span><a href={contacto.telefonoLink}>{contacto.telefono}</a></li>
          <li><span class="hud hud--mute">Correo</span><a href={contacto.correoLink}>{contacto.correo}</a></li>
        </ul>
      </div>

      <div class="matricula__form rv">
        <Formulario asunto={`Curso: ${curso.titulo}`} />
      </div>
    </div>
  </section>

  <!-- ======== 6 · INFORMACIÓN INSTITUCIONAL Y MARCAS ======== -->
  <Institucional indice="06" />

  <section class="seccion otros">
    <div class="wrap">
      <span class="hud">Otros programas</span>
      <h2 class="titulo-seccion otros__titulo">
        <span class="mask"><span>Sigue <em>especializándote</em></span></span>
      </h2>
      <ul class="otros__grid">
        {otros.map((c, n) => <li><TarjetaCurso curso={c} retraso={n * 90} /></li>)}
      </ul>
    </div>
  </section>
  </div>
</Base>

<style>
  .indice { padding-right: 12px; margin-right: 4px; border-right: 1px solid var(--line); color: var(--mute); }

  /* ---------- portada ---------- */
  .portada {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(460px, 74vh, 720px);
    padding-block: clamp(92px, 11vw, 140px) clamp(40px, 5vw, 70px);
    overflow: hidden;
  }
  .portada__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(58% 60% at 78% 24%, color-mix(in srgb, var(--azul) 46%, transparent), transparent 70%),
      radial-gradient(44% 50% at 8% 86%, color-mix(in srgb, var(--acento) 14%, transparent), transparent 70%),
      var(--fondo);
  }
  .portada__trama {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.3;
    background: repeating-linear-gradient(0deg, var(--trama) 0 1px, transparent 1px 3px);
  }
  .portada__cuerpo { position: relative; z-index: 2; }

  .miga {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .miga a:hover { color: var(--acento); }
  .miga [aria-current] { color: var(--texto); }

  .portada__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  @media (max-width: 900px) {
    .portada__grid { grid-template-columns: 1fr; }
    .portada__cubierta { order: -1; }
  }

  .portada__marca { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; color: var(--texto); }
  .portada__tech { flex: 0 0 auto; padding-left: 16px; border-left: 1px solid var(--line); }
  .portada__titulo { font-size: clamp(32px, 4.8vw, 68px); line-height: 0.95; }
  .portada__sub {
    max-width: 48ch;
    margin-top: 18px;
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.5;
    color: var(--mute);
  }
  .portada__datos {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 2.4vw, 34px);
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
