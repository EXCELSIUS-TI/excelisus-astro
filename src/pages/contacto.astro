---
import Base from '@/layouts/Base.astro';
import Portada from '@/components/ui/Portada.astro';
import Formulario from '@/components/ui/Formulario.astro';
import Orbe from '@/components/ui/Orbe.astro';
import { contacto, linkWhatsapp, linkCorreo } from '@/data/site';

const consulta = encodeURIComponent(`${contacto.direccion}, ${contacto.ciudad}`);
const canales = [
  {
    hud: 'WhatsApp',
    valor: 'Escríbenos ahora',
    detalle: 'La vía más rápida: respondemos en horario de oficina.',
    href: linkWhatsapp(
      'Hola Excelsius, escribo desde la página de contacto de la web. Quisiera información sobre sus servicios y cursos.',
    ),
    externo: true,
  },
  {
    hud: 'Teléfono',
    valor: contacto.telefono,
    detalle: 'Llámanos de lunes a viernes.',
    href: contacto.telefonoLink,
    externo: false,
  },
  {
    hud: 'Correo',
    valor: contacto.correo,
    detalle: 'Para propuestas, temarios y documentación.',
    href: linkCorreo(
      'Consulta desde la web de Excelsius',
      'Hola Excelsius:\n\nEscribo desde la página de contacto. Quisiera información sobre:\n\n',
    ),
    externo: false,
  },
];
---

<Base
  titulo="Contacto"
  descripcion="Conversemos sobre tu proyecto de software, analítica de datos o capacitación. WhatsApp, teléfono y correo de EXCELSIUS.">
  <Portada
    hud="Contacto"
    titulo="Hablemos"
    acento="de tu proyecto"
    entradilla="Cuéntanos qué proceso quieres resolver o qué curso te interesa. La primera conversación de diagnóstico no tiene costo y sale de ella una propuesta concreta, no una presentación comercial."
    datos={[
      { etiqueta: 'Teléfono', valor: contacto.telefono },
      { etiqueta: 'Correo', valor: contacto.correo },
      { etiqueta: 'Atención', valor: contacto.horario },
    ]}
  />

  <section class="seccion">
    <div class="wrap">
      <ul class="canales">
        {canales.map((c, n) => (
          <li class="tarjeta canal rv" data-retraso={n * 90}>
            <a
              href={c.href}
              class="canal__enlace"
              {...(c.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="hud">{c.hud}</span>
              <span class="canal__valor">{c.valor}</span>
              <span class="canal__detalle">{c.detalle}</span>
              <span class="canal__flecha" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 11h12.2l-5.6-5.6L12 4l8 8-8 8-1.4-1.4 5.6-5.6H4z"></path></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="cuerpo">
        <div class="cuerpo__form rv">
          <span class="hud">Formulario</span>
          <h2 class="titulo-seccion cuerpo__titulo">
            <span class="mask"><span>Escríbenos <em>directo</em></span></span>
          </h2>
          <p class="entradilla">
            Completa el formulario y elige cómo enviarlo: se arma el mensaje y se abre tu WhatsApp
            o tu correo, ya redactado.
          </p>
          <div class="cuerpo__caja">
            <Formulario asunto="Formulario de contacto" />
          </div>
        </div>

        <aside class="cuerpo__lado rv">
          <div class="dato">
            <span class="hud hud--mute">Oficina</span>
            <p>{contacto.direccion}</p>
            <p>{contacto.ciudad}</p>
          </div>
          <div class="dato">
            <span class="hud hud--mute">Horario de atención</span>
            <p>{contacto.horario}</p>
            <p>{contacto.horarioClases}</p>
          </div>
          <div class="dato">
            <span class="hud hud--mute">Redes</span>
            <div class="redes">
              {contacto.redes.map((r) => (
                <a href={r.url} target="_blank" rel="noopener noreferrer">{r.nombre}</a>
              ))}
            </div>
          </div>

          <div class="mapa" data-mapa>
            <!-- el mapa de Google tarda: el orbe ocupa su sitio mientras llega -->
            <div class="mapa__espera" data-espera>
              <Orbe estado="searching" tamano={64} etiqueta="Cargando el mapa" />
              <span class="hud hud--mute">Cargando el mapa</span>
            </div>
            <iframe
              title="Ubicación de Excelsius"
              src={`https://www.google.com/maps?q=${consulta}&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              data-mapa-marco></iframe>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .canales {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .canales { grid-template-columns: 1fr; }
  }
  /* la tarjeta entera es el enlace: el área de clic es toda la ficha y no
     solo el número o el correo */
  .canal { padding: 0; }
  .canal__enlace {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: clamp(24px, 2.6vw, 34px);
  }
  .canal__valor {
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }
  .canal:hover .canal__valor { color: var(--acento); }
  .canal__detalle { font-size: 13.5px; line-height: 1.6; color: var(--mute); }
  .canal__flecha { margin-top: auto; padding-top: 18px; }
  .canal__flecha svg {
    width: 22px;
    height: 22px;
    fill: var(--acento);
    transition: transform 0.25s ease;
  }
  .canal:hover .canal__flecha svg { transform: translateX(6px); }

  .cuerpo {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(32px, 4vw, 64px);
    margin-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; }
  }
  .cuerpo__titulo { margin-top: 16px; }
  .cuerpo__caja {
    margin-top: 28px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--superficie);
  }

  .cuerpo__lado { display: flex; flex-direction: column; gap: 24px; }
  .dato { display: flex; flex-direction: column; gap: 8px; padding-left: 16px; border-left: 1px solid var(--line); }
  .dato p { font-size: 14.5px; line-height: 1.5; }
  .redes { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2px; }
  .redes a {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .redes a:hover { color: var(--acento); }

  .mapa {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  /* el mapa de Google llega claro: solo se invierte con el sitio en oscuro */
  :root[data-tema='oscuro'] .mapa {
    filter: grayscale(1) invert(0.92) hue-rotate(185deg) contrast(0.9);
  }
  .mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .mapa[data-cargado] iframe { opacity: 1; }

  .mapa__espera {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: var(--superficie);
    transition: opacity 0.4s ease, visibility 0.4s;
  }
  .mapa[data-cargado] .mapa__espera { opacity: 0; visibility: hidden; }
</style>
