---
import { contacto } from '@/data/site';
import Cabecera from '@/components/ui/Cabecera.astro';
import Formulario from '@/components/ui/Formulario.astro';
---

<section id="contacto" class="seccion contacto">
  <div class="wrap contacto__cuerpo">
    <div>
      <Cabecera
        indice="06"
        hud="Conversemos"
        titulo="Cuéntanos el problema,"
        acento="no la solución"
        entradilla="Escríbenos qué proceso te está costando tiempo o dinero. Del cómo resolverlo nos encargamos nosotros: la primera conversación de diagnóstico no tiene costo."
      />

      <ul class="datos">
        <li>
          <span class="hud hud--mute">Teléfono</span>
          <a href={contacto.telefonoLink} class="datos__valor">{contacto.telefono}</a>
        </li>
        <li>
          <span class="hud hud--mute">Correo</span>
          <a href={contacto.correoLink} class="datos__valor">{contacto.correo}</a>
        </li>
        <li>
          <span class="hud hud--mute">WhatsApp</span>
          <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="datos__valor">
            Escríbenos ahora
          </a>
          <span class="datos__sub">{contacto.horario}</span>
        </li>
      </ul>
    </div>

    <div class="contacto__form rv">
      <span class="hud">Formulario de contacto</span>
      <Formulario asunto="Contacto desde el inicio" />
    </div>
  </div>
</section>

<style>
  .contacto { background: var(--superficie); }

  .contacto__cuerpo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .contacto__cuerpo { grid-template-columns: 1fr; }
  }

  .datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
    margin-top: clamp(32px, 4vw, 52px);
  }
  @media (max-width: 520px) {
    .datos { grid-template-columns: 1fr; }
  }
  .datos li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  .datos__valor { font-size: 15px; line-height: 1.45; transition: color 0.2s ease; }
  a.datos__valor:hover { color: var(--acento); }
  .datos__sub { font-size: 13px; color: var(--mute); }

  .contacto__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--fondo);
  }
</style>
