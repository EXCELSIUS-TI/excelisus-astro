---
import { contacto, rutas, site } from '@/data/site';
---

<!--
  El visor de arquitectura: el grafo de servicios, los cuatro puertos de datos
  y la señal de throughput se dibujan por código sobre los dos canvas.
-->
<section id="hero" class="hero zona-oscura">
  <div class="hero__fondo" aria-hidden="true"></div>
  <div class="hero__velo" aria-hidden="true"></div>
  <div class="hero__trama" aria-hidden="true"></div>

  <canvas id="visor" class="hero__visor" aria-hidden="true"></canvas>
  <canvas id="senal" class="hero__senal" aria-hidden="true"></canvas>

  <!-- lecturas del monitor -->
  <div class="hero__lecturas">
    <span class="lectura">Latencia <b class="mono-num" data-lectura="latencia">42</b> ms</span>
    <span class="lectura">Peticiones <b class="mono-num" data-lectura="peticiones">1.2k</b> /s</span>
    <span class="lectura">Uptime <b class="mono-num">99.9</b> %</span>
    <span class="lectura">Despliegues <b class="mono-num">312</b></span>
  </div>

  <div class="hero__grande">
    <span class="hud hud--mute">Operaciones por minuto</span>
    <b class="mono-num hero__cifra" data-lectura="throughput">148</b>
  </div>

  <div class="hero__texto">
    <span class="hud hero__claim anim-fade" style="animation-delay:.7s">{site.claim}</span>

    <h1 class="display hero__titulo">
      <span class="mask"><span class="anim-rise">Software</span></span>
      <span class="mask">
        <span class="anim-rise" style="animation-delay:.1s">
          <span class="fill-word" data-word="a medida">a medida</span>
        </span>
      </span>
      <span class="mask">
        <span class="anim-rise" style="animation-delay:.2s">en <em>producción</em></span>
      </span>
    </h1>

    <p class="hero__bajada anim-fade" style="animation-delay:.9s">
      Somos la empresa de software que tu negocio necesita: sistemas, apps, ERP Odoo, Business
      Intelligence y Machine Learning. Más los cursos en vivo para sostenerlo.
    </p>

    <div class="hero__acciones anim-fade" style="animation-delay:1.1s">
      <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer" class="cta cta--azul">
        <i></i>Solicitar cotización
      </a>
      <a href={rutas.servicios} class="cta cta--linea">Ver servicios</a>
      <a href={rutas.cursos} class="cta cta--linea">Ver cursos</a>
    </div>
  </div>

  <span class="hero__scroll" aria-hidden="true">
    Scroll
    <i></i>
  </span>
</section>

<script>
  import { iniciarHero } from '@/scripts/hero';
  iniciarHero();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    cursor: crosshair;
  }
  @media (max-width: 760px) {
    .hero { height: 86svh; min-height: 520px; padding-top: 0; cursor: default; }
  }

  /* resplandor del centro de datos, dibujado con gradientes: sin fotos */
  .hero__fondo {
    position: absolute;
    inset: -4%;
    z-index: 0;
    background:
      radial-gradient(60% 55% at 72% 46%, rgba(4, 48, 207, 0.4), transparent 70%),
      radial-gradient(40% 40% at 20% 18%, rgba(94, 211, 255, 0.12), transparent 70%),
      radial-gradient(70% 60% at 50% 100%, rgba(2, 26, 115, 0.45), transparent 70%),
      var(--fondo);
  }
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, var(--fondo) 0%, rgba(5, 7, 15, 0.86) 30%, rgba(5, 7, 15, 0.3) 62%, rgba(5, 7, 15, 0.6) 100%),
      linear-gradient(180deg, rgba(5, 7, 15, 0.6), transparent 30%, transparent 70%, var(--fondo));
  }
  .hero__trama {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.35;
    background: repeating-linear-gradient(0deg, var(--trama) 0 1px, transparent 1px 3px);
  }

  .hero__visor {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__senal {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 4;
    display: block;
    width: 100%;
    height: 72px;
    pointer-events: none;
  }

  .hero__lecturas {
    position: absolute;
    bottom: 84px;
    left: var(--pad);
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 2.6vw, 40px);
  }
  .lectura {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .lectura b { font-weight: 400; color: var(--texto); }
  @media (max-width: 900px) {
    .hero__lecturas { bottom: auto; top: 76px; left: 20px; }
  }
  @media (max-width: 760px) {
    .hero__lecturas { display: none; }
  }

  .hero__grande {
    position: absolute;
    bottom: 84px;
    right: var(--pad);
    z-index: 6;
    text-align: right;
  }
  .hero__cifra {
    display: block;
    font-size: clamp(28px, 3.4vw, 46px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--acento);
  }
  @media (max-width: 900px) {
    .hero__grande { display: none; }
  }

  .hero__texto {
    position: absolute;
    left: var(--pad);
    top: 50%;
    z-index: 6;
    max-width: min(680px, 48vw);
    transform: translateY(-52%);
  }
  @media (max-width: 900px) {
    .hero__texto {
      top: auto;
      bottom: 150px;
      right: 20px;
      max-width: none;
      transform: none;
    }
  }
  @media (max-width: 760px) {
    .hero__texto { bottom: 104px; }
  }

  .hero__claim {
    display: block;
    margin-bottom: 22px;
    max-width: 42ch;
    line-height: 1.7;
  }
  @media (max-width: 760px) {
    .hero__claim { display: none; }
  }

  .hero__titulo {
    font-size: clamp(42px, 5.8vw, 88px);
    line-height: 0.88;
    white-space: nowrap;
  }
  /* La máscara del revelado lleva `overflow: hidden` para tapar la línea
     mientras sube, y eso recorta en los dos ejes: si el renglón es más ancho
     que la columna del hero, se come la última letra —pasaba con la «n» de
     «en producción»—. Dejándola crecer hasta el ancho de su texto, el recorte
     sigue funcionando en vertical y ya no corta nada en horizontal. */
  .hero__titulo .mask { width: max-content; }
  .hero__titulo em { font-style: normal; color: var(--acento); }

  .hero__bajada {
    margin-top: 24px;
    max-width: 38ch;
    font-size: clamp(14px, 1.25vw, 17px);
    line-height: 1.55;
    color: var(--mute);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  @media (max-width: 1200px) {
    .hero__acciones .cta { padding: 17px 22px; letter-spacing: 0.18em; }
  }
  @media (max-width: 760px) {
    .hero__acciones .cta { padding: 15px 18px; font-size: 10.5px; letter-spacing: 0.16em; }
  }

  .hero__scroll {
    position: absolute;
    bottom: 160px;
    right: var(--pad);
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 14px;
    writing-mode: vertical-rl;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .hero__scroll i {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(var(--acento), transparent);
    animation: drop 2.1s infinite;
  }
  @media (max-width: 900px) {
    .hero__scroll { display: none; }
  }
</style>
