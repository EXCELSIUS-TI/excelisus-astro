---
import { proceso } from '@/data/site';
import Cabecera from '@/components/ui/Cabecera.astro';
---

<section id="metodo" class="seccion proceso">
  <div class="wrap">
    <Cabecera
      indice="03"
      hud="Cómo trabajamos"
      titulo="Del diagnóstico"
      acento="a la adopción"
      entradilla="Un proyecto no termina cuando el código compila, sino cuando el equipo del cliente lo usa todos los días. Esta es la secuencia, y cada paso tiene un entregable que se puede revisar."
    />

    <ol class="pasos">
      {proceso.map((p, n) => (
        <li class="paso rv" data-retraso={n * 70}>
          <span class="mono-num paso__num">{p.paso}</span>
          <div class="paso__cuerpo">
            <h3 class="paso__titulo">{p.nombre}</h3>
            <p class="paso__texto">{p.detalle}</p>
          </div>
          <span class="paso__linea" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proceso { background: var(--superficie); }

  .pasos {
    margin-top: clamp(40px, 5vw, 72px);
    counter-reset: paso;
  }

  .paso {
    position: relative;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: clamp(16px, 3vw, 44px);
    padding-block: clamp(22px, 2.6vw, 34px);
    border-top: 1px solid var(--line);
  }
  .paso:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 640px) {
    .paso { grid-template-columns: 56px 1fr; gap: 14px; }
  }

  .paso__num {
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--acento) 45%, transparent);
    transition: color 0.3s ease;
  }
  .paso:hover .paso__num { color: var(--acento); }

  .paso__cuerpo { display: flex; flex-direction: column; gap: 10px; max-width: 70ch; }
  .paso__titulo {
    font-size: clamp(17px, 1.7vw, 24px);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .paso__texto { font-size: 14px; line-height: 1.65; color: var(--mute); }

  /* filo que se dibuja al pasar por encima */
  .paso__linea {
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: linear-gradient(90deg, var(--azul), var(--acento));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .paso:hover .paso__linea { transform: scaleX(1); }
</style>
