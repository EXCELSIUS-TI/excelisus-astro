---
import { categoriasBlog, type CategoriaBlog } from '@/data/blog';

/**
 * Cubierta de un artículo, dibujada sin imágenes: retícula de puntos, el
 * resplandor del color de su categoría, el icono de la categoría de fondo y
 * el isotipo de Excelsius. Así todos los artículos tienen portada propia y
 * coherente desde el primer día, sin depender de un banco de fotos.
 */
type Props = {
  categoria: CategoriaBlog;
  slug: string;
  minutos: number;
  variante?: 'tarjeta' | 'destacado';
};

const { categoria, slug, minutos, variante = 'tarjeta' } = Astro.props;
const cat = categoriasBlog[categoria];
---

<div
  class={`cubierta cubierta--${variante}`}
  style={`--tono:${cat.tono};--tono-claro:${cat.tonoClaro}`}
  aria-hidden="true">
  <span class="cubierta__puntos"></span>
  <span class="cubierta__halo"></span>
  <svg class="cubierta__icono" viewBox="0 0 24 24"><path d={cat.icono}></path></svg>

  <img class="cubierta__logo" src="/favicon.png" alt="" width="40" height="40" loading="lazy" decoding="async" />

  <span class="cubierta__codigo">
    <span class="cubierta__prompt">~/blog $</span> cat {slug}.md
  </span>
  <span class="cubierta__meta">{cat.nombre} · {minutos} min</span>
</div>

<style>
  /* La cubierta es un «monitor»: oscura en los dos temas, como el hero */
  .cubierta {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #0a0612;
    isolation: isolate;
  }
  .cubierta--destacado { aspect-ratio: 16 / 10; }

  .cubierta__puntos {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.13) 1px, transparent 1.4px);
    background-size: 16px 16px;
    mask-image: linear-gradient(120deg, #000 20%, transparent 85%);
  }
  .cubierta__halo {
    position: absolute;
    right: -18%;
    top: -30%;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--tono) 55%, transparent), transparent 65%);
    filter: blur(10px);
  }
  .cubierta__icono {
    position: absolute;
    right: 6%;
    bottom: -8%;
    width: 46%;
    height: auto;
    fill: var(--tono);
    opacity: 0.2;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  :global(.tarjeta-articulo:hover) .cubierta__icono { transform: translateY(-6px) rotate(-4deg); opacity: 0.3; }

  .cubierta__logo {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 34px;
    height: 34px;
  }
  .cubierta--destacado .cubierta__logo { width: 46px; height: 46px; top: 22px; left: 22px; }

  .cubierta__codigo,
  .cubierta__meta {
    position: absolute;
    left: 16px;
    font-family: var(--mono);
    letter-spacing: 0.06em;
    color: rgba(233, 237, 247, 0.72);
  }
  .cubierta__codigo {
    bottom: 38px;
    right: 16px;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cubierta__prompt { color: var(--tono); }
  .cubierta__meta {
    bottom: 16px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--tono);
  }
  .cubierta--destacado .cubierta__codigo { font-size: 13px; left: 22px; bottom: 46px; }
  .cubierta--destacado .cubierta__meta { left: 22px; bottom: 22px; font-size: 11px; }
</style>
