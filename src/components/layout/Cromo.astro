---
/** Retícula de fondo, barra de progreso y botón flotante de WhatsApp. */
import { contacto } from '@/data/site';
---

<div class="reticula" aria-hidden="true"></div>
<span id="progreso" class="progreso" aria-hidden="true"></span>

<a
  href={contacto.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  class="wa"
  aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.4-3.9-4.5-4.1-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1.1.9 1.9 1.2 2.2 1.4.3.1.5.1.6-.1l.8-1c.2-.2.4-.2.6-.1l2 1c.2.1.4.2.5.3.1.2.1.6-.1 1.1z"></path>
  </svg>
</a>

<style>
  /* ocho columnas en escritorio, tres en móvil */
  .reticula {
    position: fixed;
    inset: 0 0 0 var(--rail);
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 calc(12.5% - 1px),
      var(--reticula) calc(12.5% - 1px) 12.5%
    );
  }
  @media (max-width: 759px) {
    .reticula {
      background: repeating-linear-gradient(
        90deg,
        transparent 0 calc(33.33% - 1px),
        var(--reticula) calc(33.33% - 1px) 33.33%
      );
    }
  }

  .progreso {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 90;
    height: 2px;
    background: linear-gradient(90deg, var(--azul), var(--acento));
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (max-width: 759px) {
    .progreso { top: 60px; }
  }

  .wa {
    position: fixed;
    right: clamp(16px, 2.4vw, 28px);
    bottom: clamp(16px, 2.4vw, 28px);
    z-index: 85;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line-fuerte);
    background: var(--superficie);
    color: var(--acento);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .wa:hover { background: var(--acento); color: var(--fondo); transform: translateY(-3px); }
  .wa svg { width: 24px; height: 24px; fill: currentColor; }
</style>
