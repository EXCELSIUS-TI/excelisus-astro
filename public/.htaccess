# ==========================================================
#  EXCELSIUS — configuración de Apache para cPanel
#  Sube el contenido de `dist/` a `public_html/`: este archivo
#  viaja con él (está en `public/`).
# ==========================================================

# ---------- Página de error ----------
ErrorDocument 404 /404.html

# ---------- URL limpias ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Una sola URL canónica: https y con www (la misma del sitemap, las canónicas
  # y Open Graph). Si el SSL aún no está activo, comenta estas tres líneas.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.excelsius.biz/$1 [R=301,L]

  # /cursos  ->  /cursos/   (el sitio se genera con barra final)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # redirecciones desde las URL antiguas de WordPress. Ojo: una regla no puede
  # apuntar a una URL que ella misma vuelve a capturar (`^nosotros/?$ ->
  # /nosotros/` redirigía a /nosotros/ en bucle: ERR_TOO_MANY_REDIRECTS).
  # /nosotros y /contacto ya los resuelve la regla de la barra final.
  RewriteRule ^cursos/seguridad-y-gestion-ambiental/?$ /cursos/#seguridad [R=301,L]
  RewriteRule ^cursos/marketing-publicidad-y-comunicaciones/?$ /cursos/#marketing [R=301,L]
  RewriteRule ^cursos/gestion-y-analisis-de-datos/?$ /cursos/#datos [R=301,L]
</IfModule>

# ---------- Compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# ---------- Caché del navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/plain                "access plus 1 day"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# los assets de Astro llevan hash en el nombre: se pueden cachear para siempre
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|ttf|otf|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # las respuestas del formulario nunca se guardan en caché
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  # cabeceras de seguridad básicas
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Tipos MIME ----------
<IfModule mod_mime.c>
  # llms.txt y llms-full.txt llevan tildes: sin esto Apache los sirve en ISO-8859-1
  AddCharset UTF-8                .txt .html .css .js .xml .json
  AddType text/plain              .txt
  AddType font/ttf                .ttf
  AddType font/woff2              .woff2
  AddType image/svg+xml           .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- Formulario (PHP) ----------
# config.php solo lo incluyen los otros scripts: nadie debe abrirlo directo.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# ---------- Índices de directorio apagados ----------
Options -Indexes
